# Хост облака. JAICP по умолчанию; для Tovie Platform раскомментируйте вторую строку.
# JAICP_HOST=https://app.jaicp.com
# JAICP_HOST=https://platform.tovie.ai

# Раздел «Доступ к API»: проекты, каналы, аналитика, текстовые рассылки
JAICP_UNIFIED_TOKEN=

# Short name проекта по умолчанию (query и {projectShortName})
JAICP_PROJECT_SHORT_NAME=

# CAILA / NLP Direct. Без него спека caila не вызовется
JAICP_NLP_TOKEN=

# Dialer / обзвоны. Без него спека calls не вызовется
JAICP_CALLS_TOKEN=

# Запретить мутации даже с confirm=true
# JAICP_READ_ONLY=true

# HTTP без TLS только для localhost, либо явно:
# JAICP_ALLOW_INSECURE_HOST=1

# JAICP_FETCH_TIMEOUT_MS=120000
# JAICP_MAX_RESPONSE_BYTES=2000000
