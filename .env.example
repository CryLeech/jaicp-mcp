# Хост. Обычно не трогайте.
# JAICP_HOST=https://app.jaicp.com

# Раздел «Доступ к API» в JAICP: проекты, каналы, аналитика, текстовые рассылки
JAICP_UNIFIED_TOKEN=

# Short name проекта по умолчанию (подставляется в query, если параметр есть)
JAICP_PROJECT_SHORT_NAME=

# CAILA Direct. Без него спека caila не вызовется
JAICP_NLP_TOKEN=

# Dialer / обзвоны. Без него спека calls не вызовется
JAICP_CALLS_TOKEN=
